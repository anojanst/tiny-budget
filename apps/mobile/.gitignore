.expo/
dist/
web-build/

# Generated by `expo prebuild`, regenerated on every build so it always
# matches app.json rather than drifting from it.
android/
ios/

# Signing material. A committed keystore is compromised permanently — it is
# the app's identity, and it cannot be rotated without every user
# uninstalling and losing their budget.
*.keystore
*.jks
*.p8
*.p12
*.key
*.mobileprovision
