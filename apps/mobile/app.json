{
  "expo": {
    "name": "Money Ahead",
    "slug": "money-ahead",
    "version": "1.2.0",
    "orientation": "portrait",
    "scheme": "moneyahead",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.moneyahead.app"
    },
    "android": {
      "package": "com.moneyahead.app",
      "versionCode": 3,
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "@react-native-community/datetimepicker",
      "expo-sharing"
    ]
  }
}
