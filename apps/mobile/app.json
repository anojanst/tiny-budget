{
  "expo": {
    "name": "Tiny Budget",
    "slug": "tiny-budget",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "tinybudget",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tinybudget.app"
    },
    "android": {
      "package": "com.tinybudget.app",
      "versionCode": 1,
      "edgeToEdgeEnabled": true,
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router"
    ]
  }
}
