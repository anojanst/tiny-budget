{
  "expo": {
    "name": "Money Ahead",
    "slug": "money-ahead",
    "version": "1.2.1",
    "orientation": "portrait",
    "scheme": "moneyahead",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.moneyahead.app"
    },
    "android": {
      "package": "com.moneyahead.app",
      "versionCode": 4,
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFCB45"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "@react-native-community/datetimepicker",
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "backgroundColor": "#FFCB45",
          "imageWidth": 240,
          "resizeMode": "contain"
        }
      ]
    ],
    "icon": "./assets/icon.png",
    "backgroundColor": "#FFCB45"
  }
}
